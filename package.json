{
  "name": "tree-sitter-tree-sitter-poweron",
  "version": "0.1.0",
  "description": "TreeSitterPoweron grammar for tree-sitter",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+gitea@repo.partnercoloradocu.org:sheldonm/tree-sitter-poweron.git.git"
  },
  "funding": "",
  "license": "MIT",
